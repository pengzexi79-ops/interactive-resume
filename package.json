{
  "name": "interactive-resume",
  "version": "0.1.0",
  "private": true,
  "description": "彭泽曦的交互式个人简历与个人品牌网站，展示 AI 实践、项目经历和成长轨迹。",
  "license": "MIT",
  "author": "彭泽曦",
  "keywords": [
    "interactive-resume",
    "personal-website",
    "portfolio",
    "react",
    "nextjs",
    "typescript",
    "ai-native"
  ],
  "homepage": "https://stunning-puffpuff-d8b0be.netlify.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/pengzexi79-ops/interactive-resume.git"
  },
  "bugs": {
    "url": "https://github.com/pengzexi79-ops/interactive-resume/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "portable": "node scripts/generate-portable.mjs",
    "qr": "qrcode -o public/official-homepage-qr.png -w 512 -q 4 -e H https://stunning-puffpuff-d8b0be.netlify.app",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.28.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "qrcode": "^1.5.4",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "彭泽曦｜AI 原生实践者"
}
